generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum ItemCategory {
  CARD
  SUPPLY
  INVERTER
}

model Brand {
  id        String          @id @default(cuid())
  name      String          @unique
  createdAt DateTime        @default(now())
  items     InventoryItem[]
}

model InventoryItem {
  id          String       @id @default(cuid())
  modelNumber String
  brandId     String
  brand       Brand        @relation(fields: [brandId], references: [id])
  category    ItemCategory
  boxLocation String?      // admin-only field
  description String?      @db.Text
  frontImage  String       // Cloudinary secure URL
  backImage   String?      // optional Cloudinary secure URL
  isDeleted   Boolean      @default(false)
  isNotSure   Boolean      @default(false)
  notSureAt   DateTime?
  notSureRemarks String?   @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@index([isDeleted])
  @@index([isNotSure])
  @@index([category])
  @@index([brandId])
  @@index([createdAt(sort: Desc)])
}
